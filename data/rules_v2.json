{
  "schema_version": "0.1",
  "project": "OptiFit AI",
  "purpose": "Starter rule dataset for eyewear recommendation; prototype rules that should be validated and tuned.",
  "principles": {
    "face_shape": "Use face shape only as a style signal, not as a judgment of attractiveness.",
    "material": "Do not infer material from face shape alone. Base it mainly on weight, durability, comfort, lens needs and style preference.",
    "color": "Color recommendations are subjective and lighting-sensitive. Prefer user-selected undertone/contrast or neutral-light analysis with confidence.",
    "size": "Do not claim exact glasses size from an uncalibrated face photo. Prefer a known comfortable frame size, manufacturer front width, or calibrated measurement.",
    "fit_priority": "Check physical fit before style scoring."
  },
  "face_shape_classes": [
    "oval",
    "round",
    "square",
    "heart",
    "oblong",
    "diamond"
  ],
